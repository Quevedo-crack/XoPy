<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XoPy</RootNamespace>
    <AssemblyName>XoPy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\xopy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.4.6</Version>
    <AssemblyVersion>2.4.6.0</AssemblyVersion>
    <FileVersion>2.4.6.0</FileVersion>
    <Product>XoPy</Product>
    <AssemblyTitle>XoPy</AssemblyTitle>
    <Company>Quevedo-crack</Company>
    <Description>Gestor de copias de archivos para Windows</Description>
    <Copyright>© 2026 Quevedo-crack</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Publicación autocontenida para cualquier PC limpia -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- IL Trimming para reducir tamaño (partial es más seguro para WinForms que full) -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- Globalización invariante: elimina ICU y ensamblados satélite de idioma -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
