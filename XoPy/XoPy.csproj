<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XoPy</RootNamespace>
    <AssemblyName>XoPy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\xopy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.5.5</Version>
    <AssemblyVersion>2.5.5.0</AssemblyVersion>
    <FileVersion>2.5.5.0</FileVersion>
    <Product>XoPy</Product>
    <AssemblyTitle>XoPy</AssemblyTitle>
    <Company>Quevedo-crack</Company>
    <Description>Gestor de copias de archivos para Windows</Description>
    <Copyright>© 2026 Quevedo-crack</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>