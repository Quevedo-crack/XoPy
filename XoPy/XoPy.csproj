<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XoPy</RootNamespace>
    <AssemblyName>XoPy</AssemblyName>
    <ApplicationIcon>Assets\xopy.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\xopy.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
