<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XoPy</RootNamespace>
    <AssemblyName>XoPy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\xopy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.6.2</Version>
    <AssemblyVersion>2.6.2.0</AssemblyVersion>
    <FileVersion>2.6.2.0</FileVersion>
    <Product>XoPy</Product>
    <AssemblyTitle>XoPy</AssemblyTitle>
    <Company>Quevedo-crack</Company>
    <Description>Gestor de copias de archivos para Windows</Description>
    <Copyright>© 2026 Quevedo-crack</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rutas de más de 260 caracteres: en TeraCopy es una de las causas reales de «Error».
         .NET ya las soporta en Windows 10+; se declara explícitamente para el runtime.
         Los RuntimeHostConfigurationOption van en un ItemGroup, no en PropertyGroup. -->
    <RuntimeHostConfigurationOption Include="System.IO.UseLegacyPathHandling" Value="false" />
    <RuntimeHostConfigurationOption Include="Switch.System.IO.UseLegacyPathHandling" Value="false" />
  </ItemGroup>
</Project>
